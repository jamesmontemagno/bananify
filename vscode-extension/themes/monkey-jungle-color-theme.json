  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#91AA98", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "constant.other.symbol"],
      "settings": { "foreground": "#D7C96B" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#A8DB72" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#73D0A2" }
    },
    {
      "scope": ["entity.name.type", "support.type", "support.class"],
      "settings": { "foreground": "#F3B268" }
    },
    {
      "scope": ["variable", "meta.definition.variable.name"],
      "settings": { "foreground": "#E9F4E8" }
    },
    {
      "scope": ["constant.numeric", "constant.language"],
      "settings": { "foreground": "#E98B70" }
    }
  ]
